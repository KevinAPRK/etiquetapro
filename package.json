{
  "name": "etiquetapro",
  "productName": "EtiquetaPro",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Sistema Profesional de Diseño e Impresión de Etiquetas",
  "main": "electron/main.cjs",
  "scripts": {
    "server": "node server/server.cjs",
    "dev": "concurrently -k \"node server/server.cjs\" \"vite\"",
    "build": "tsc -b && vite build",
    "desktop": "concurrently -k \"node server/server.cjs\" \"vite\" \"wait-on tcp:5173 && electron electron/main.cjs\"",
    "start": "concurrently -k \"node server/server.cjs\" \"vite\" \"wait-on tcp:5173 && electron electron/main.cjs\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "html2canvas": "^1.4.1",
    "jsbarcode": "^3.12.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.49.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.5.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wait-on": "^9.5.1"
  }
}
